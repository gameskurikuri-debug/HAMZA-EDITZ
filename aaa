-- --- 各種関数（レインボー・アニメーション・トグル） ---
local function startRainbowEffect(textLabel)
    task.spawn(function()
        local hue = 0
        while textLabel and textLabel.Parent do
            hue = (hue + 0.01) % 1
            textLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
            RunService.RenderStepped:Wait()
        end
    end)
end

local function popIn(instance)
    instance.Size = UDim2.new(0, 0, 0, 0)
    instance.Visible = true
    tweenService:Create(instance, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 320, 0, 180)
    }):Play()
end

-- トグルボタンのクリック判定を制御するためのテーブル
local activeButtons = {}

local function createToggle(labelName, parent, yPos)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(0, 150, 0, 30)
    label.Position = UDim2.new(0.05, 0, yPos, 0)
    label.Text = labelName
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 16
    label.Font = Enum.Font.GothamBold
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left

    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(0, 60, 0, 30)
    frame.Position = UDim2.new(0.7, 0, yPos, 0)
    frame.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame", frame)
    knob.Size = UDim2.new(0, 24, 0, 24)
    knob.Position = UDim2.new(0, 3, 0.1, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    
    local isOn = false
    local function setOn(state)
        isOn = state
        local targetX = isOn and UDim2.new(0.55, 0, 0.1, 0) or UDim2.new(0, 3, 0.1, 0)
        local targetColor = isOn and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(200, 50, 50)
        knob:TweenPosition(targetX, Enum.EasingDirection.Out, Enum.EasingStyle.Back, 0.2)
        frame.BackgroundColor3 = targetColor
        if labelName == "AutoTrade" then _G.TradeEnabled = isOn else _G.FreezeEnabled = isOn end
    end

    -- ロック状態を判別してクリックを許可する
    btn.MouseButton1Click:Connect(function()
        if btn:GetAttribute("Locked") == true then return end
        setOn(not isOn)
    end)
    
    table.insert(activeButtons, btn)
    return {setOn = setOn}
end

